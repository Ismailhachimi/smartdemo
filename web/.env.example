# Copy to .env and adjust. Never commit .env.

# Public URL people open in their browser (no trailing slash).
#   docker compose: http://localhost:8080   ·   pnpm dev: http://localhost:3000
APP_URL=http://localhost:8080

# Host port of the Caddy entrypoint (docker compose only).
HTTP_PORT=8080

# Ports used by `pnpm dev`.
WEB_PORT=3000
API_PORT=4000

# Long random string used to sign media access tokens: openssl rand -hex 32
APP_SECRET=

# --- Database ---------------------------------------------------------------
# docker compose builds the connection string from these.
POSTGRES_USER=smartdemo
POSTGRES_PASSWORD=
POSTGRES_DB=smartdemo
# Used by `pnpm dev` (database from docker-compose.dev.yml).
DATABASE_URL=postgres://smartdemo:smartdemo@localhost:5433/smartdemo

# --- Email (Resend) ---------------------------------------------------------
# Leave RESEND_API_KEY empty to print emails (and sign-in links) in the API logs instead.
RESEND_API_KEY=
EMAIL_FROM=SmartDemo <onboarding@resend.dev>
# Set to 1 to also print emails in the logs when Resend is configured.
EMAIL_LOG=

# --- Access -----------------------------------------------------------------
# Who may sign in: comma-separated emails and/or @domains. Empty = anyone.
# The first account created becomes admin.
ALLOWED_EMAILS=

# --- Media storage ----------------------------------------------------------
# local: a folder (pnpm dev) or the "media" Docker volume (docker compose). Works out of the box.
# s3:    AWS S3 or any S3-compatible service (Cloudflare R2, Scaleway, OVH, Backblaze B2,
#        DigitalOcean Spaces, self-hosted SeaweedFS / Garage…).
# azure: Azure Blob Storage.
STORAGE_DRIVER=local
# Optional key prefix inside the bucket / container, e.g. smartdemo/
STORAGE_PREFIX=
# Local folder for videos when running `pnpm dev` (docker compose uses a volume).
STORAGE_DIR=./storage
MAX_UPLOAD_MB=4096

# S3 (STORAGE_DRIVER=s3). Leave S3_ENDPOINT empty for AWS.
#   Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
#   Scaleway:      S3_ENDPOINT=https://s3.fr-par.scw.cloud                     S3_REGION=fr-par
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# Azure Blob (STORAGE_DRIVER=azure). The container is created if missing.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=smartdemo
