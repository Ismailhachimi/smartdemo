# Single entrypoint: /api/* → NestJS, everything else → Next.js.
# TLS is expected to be handled upstream (Dokploy / Traefik, a load balancer…).
# To let Caddy serve HTTPS itself, replace ":80" with your domain and publish ports 80 and 443.
{
	admin off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
