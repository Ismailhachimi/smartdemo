{
  "name": "@smartdemo/emails",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "email dev --dir src/templates --port 3030"
  },
  "dependencies": {
    "@react-email/render": "2.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.16"
  },
  "devDependencies": {
    "@types/react": "19.3.3",
    "typescript": "6.0.3"
  }
}
